# ─────────────────────────────────────────────────────────────────────────────
# Required for the notebooks' Configure cells
# ─────────────────────────────────────────────────────────────────────────────

# Azure AI Foundry project endpoint
# Example: https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project>
AZURE_AI_PROJECT_ENDPOINT=<your-foundry-project-endpoint>

# Model deployment name in your Foundry project
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.1

# Bing grounding connection ID (full ARM resource id)
# Example: /subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>/connections/<connection-name>
BING_CONNECTION_ID=<your-bing-grounding-connection-id>

# Azure AI Content Safety endpoint (for citation guardrail pipeline)
# Optional — defaults to the AI Services account base URL derived from PROJECT_ENDPOINT
CONTENT_SAFETY_ENDPOINT=https://<your-foundry-acct>.cognitiveservices.azure.com/

# Judge-model deployment for the batch evaluation harness.
# REQUIRED for the batch-eval cells. Must be a gpt-4o / gpt-4o-mini / gpt-4.1
# deployment in the same Foundry account — gpt-5.x deployments reject the
# `max_tokens` param that GroundednessEvaluator hard-codes. See README.
EVAL_JUDGE_DEPLOYMENT_NAME=gpt-4o-mini

# ─────────────────────────────────────────────────────────────────────────────
# Authentication (optional)
# ─────────────────────────────────────────────────────────────────────────────
# Preferred for unattended hosts (e.g. on-prem Linux servers with no Managed
# Identity). If all three vars are set, the notebooks use a service principal
# with a client secret. If any is missing, they fall back to
# DefaultAzureCredential (`az login`, env, managed identity, ...).
#
# The principal needs RBAC on the Foundry account/project (and optionally the
# Content Safety endpoint if Layers 1/3 are enabled). See README "Authentication"
# for a concrete role-assignment flow.
AZURE_TENANT_ID=<tenant-guid>
AZURE_CLIENT_ID=<app-registration-client-id>
AZURE_CLIENT_SECRET=<client-secret>


# ─────────────────────────────────────────────────────────────────────────────
# Required ONLY if you run the (optional) provisioning section
# ─────────────────────────────────────────────────────────────────────────────

# Azure subscription that will host the Foundry account + Bing resource.
AZURE_SUBSCRIPTION_ID=<your-subscription-id>

# Resource group + region. Created if they don't already exist.
RESOURCE_GROUP=rg-foundry-bing-research
LOCATION=eastus

# Foundry (AI Services) account + project names.
# Account name constraints: 3-24 chars, lowercase letters/digits/hyphens, globally unique.
FOUNDRY_ACCOUNT=foundry-bing-research-acct
FOUNDRY_PROJECT=bing-research-proj

# Model deployment settings.
#   MODEL_NAME       = catalog model id
#   MODEL_VERSION    = pinned model version (avoids silent drift)
#   MODEL_DEPLOYMENT = deployment alias your code references at runtime
#                      (typically same as AZURE_AI_MODEL_DEPLOYMENT_NAME above)
#   MODEL_SKU        = capacity SKU; GlobalStandard = pay-as-you-go global throughput
#   MODEL_CAPACITY   = thousands of tokens-per-minute (TPM) reserved
MODEL_NAME=gpt-5.1
MODEL_VERSION=2025-11-13
MODEL_DEPLOYMENT=gpt-5.1
MODEL_SKU=GlobalStandard
MODEL_CAPACITY=50

# Grounding-with-Bing-Search resource + connection settings.
#   BING_RESOURCE        = name of the Microsoft.Bing/accounts resource
#   BING_SKU             = G1 is the standard Grounding-with-Bing SKU
#   BING_CONNECTION_NAME = alias for the connection inside the Foundry project
BING_RESOURCE=bing-grounding-research
BING_SKU=G1
BING_CONNECTION_NAME=bing-grounding-conn
